@{
    ViewData["Title"] = "About Us";
}

<div class="container py-5">
    <div class="row">
        <div class="col-12">
            <h1 class="display-4 fw-bold mb-4">About Our Book Store</h1>

            <div class="row mb-5">
                <div class="col-md-6">
                    <h3 class="fw-bold mb-3">Our Story</h3>
                    <p class="lead">
                        Founded with a passion for literature and a commitment to bringing great books
                        to readers everywhere, our Book Store has been serving book lovers for years.
                    </p>
                    <p>
                        We believe that books have the power to inspire, educate, and transform lives.
                        What started as a small local bookstore has grown into a comprehensive online
                        platform where readers can discover their next favorite book.
                    </p>
                </div>
                <div class="col-md-6 text-center">
                    <div style="font-size: 8rem; color: #667eea;">📖</div>
                </div>
            </div>

            <div class="row mb-5">
                <div class="col-md-4 mb-4">
                    <div class="card h-100 shadow-sm">
                        <div class="card-body text-center">
                            <div style="font-size: 3rem; color: #667eea;">🎯</div>
                            <h5 class="card-title mt-3">Our Mission</h5>
                            <p class="card-text">
                                To make quality books accessible to everyone while fostering a love for reading.
                            </p>
                        </div>
                    </div>
                </div>

                <div class="col-md-4 mb-4">
                    <div class="card h-100 shadow-sm">
                        <div class="card-body text-center">
                            <div style="font-size: 3rem; color: #667eea;">🌟</div>
                            <h5 class="card-title mt-3">Our Vision</h5>
                            <p class="card-text">
                                To be the leading destination for book lovers worldwide.
                            </p>
                        </div>
                    </div>
                </div>

                <div class="col-md-4 mb-4">
                    <div class="card h-100 shadow-sm">
                        <div class="card-body text-center">
                            <div style="font-size: 3rem; color: #667eea;">💖</div>
                            <h5 class="card-title mt-3">Our Values</h5>
                            <p class="card-text">
                                Quality, Community, Excellence, and Customer Satisfaction.
                            </p>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>