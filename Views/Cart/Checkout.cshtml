@model BookStore.Models.ViewModels.CheckoutViewModel
@{
    ViewData["Title"] = "Checkout";
}

<div class="container py-5">
    <h1 class="mb-4">Checkout</h1>

    <div class="row">
        <div class="col-md-8">
            <div class="card mb-4">
                <div class="card-header bg-primary text-white">
                    <h4 class="mb-0">Shipping & Payment Details</h4>
                </div>
                <div class="card-body">
                    <form method="post" action="/Cart/Checkout" id="checkoutForm">
                        @Html.AntiForgeryToken()

                        <div class="mb-3">
                            <label class="form-label">Shipping Address *</label>
                            <textarea class="form-control" name="ShippingAddress" rows="3" required
                                      placeholder="Enter your full shipping address">@Model.ShippingAddress</textarea>
                        </div>

                        <div class="mb-3">
                            <label class="form-label">Payment Method *</label>
                            <select class="form-select" name="PaymentMethod" required>
                                <option value="">Select Payment Method</option>
                                <option value="Credit Card" selected="@(Model.PaymentMethod == "Credit Card")">Credit Card</option>
                                <option value="PayPal" selected="@(Model.PaymentMethod == "PayPal")">PayPal</option>
                                <option value="Cash on Delivery" selected="@(Model.PaymentMethod == "Cash on Delivery")">Cash on Delivery</option>
                            </select>
                        </div>

                        <div class="mb-3">
                            <label class="form-label">Email</label>
                            <input type="email" class="form-control" name="Email" value="@Model.Email"
                                   placeholder="Your email for order updates">
                        </div>

                        <div class="mb-3">
                            <label class="form-label">Phone Number</label>
                            <input type="tel" class="form-control" name="PhoneNumber" value="@Model.PhoneNumber"
                                   placeholder="Your phone number">
                        </div>

                        <!-- ====== إضافة: Order Review قبل الدفع ====== -->
                        <div class="card mb-4 border-warning">
                            <div class="card-header bg-warning">
                                <h5 class="mb-0"><i class="fas fa-exclamation-circle me-2"></i> Order Review</h5>
                            </div>
                            <div class="card-body">
                                <p>Please review your order before payment:</p>
                                <ul class="mb-3">
                                    <li><strong>Items:</strong> @Model.Cart.ItemCount item(s)</li>
                                    <li><strong>Total Amount:</strong> $@Model.Cart.Total.ToString("0.00")</li>
                                    <li><strong>Shipping to:</strong> Address you entered above</li>
                                    <li><strong>Payment Method:</strong> Method you selected above</li>
                                </ul>
                                <div class="form-check mb-3">
                                    <input class="form-check-input" type="checkbox" id="confirmOrder" required>
                                    <label class="form-check-label" for="confirmOrder">
                                        <strong>I confirm that I have reviewed my order details and shipping information</strong>
                                    </label>
                                </div>
                            </div>
                        </div>

                        <div class="alert alert-info">
                            <i class="fas fa-info-circle me-2"></i>
                            Your order will be processed once payment is confirmed.
                        </div>

                        <!-- ====== زر الدفع المعدل ====== -->
                        <div class="d-grid">
                            <button type="submit" class="btn btn-success btn-lg" onclick="return confirmPayment()">
                                <i class="fas fa-lock me-2"></i> Complete Purchase - $@Model.Cart.Total.ToString("0.00")
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card">
                <div class="card-header">
                    <h5 class="mb-0">Order Summary</h5>
                </div>
                <div class="card-body">
                    <div class="mb-3">
                        <h6>Items in Cart (@Model.Cart.ItemCount)</h6>
                        <div class="border rounded p-2" style="max-height: 200px; overflow-y: auto;">
                            @foreach (var item in Model.Cart.Items)
                            {
                                <div class="d-flex justify-content-between mb-2">
                                    <div>
                                        <small>@item.Title (x@(item.Quantity))</small>
                                    </div>
                                    <div>
                                        <small>$@((item.Price * item.Quantity).ToString("0.00"))</small>
                                    </div>
                                </div>
                            }
                        </div>
                    </div>

                    <div class="border-top pt-3">
                        <div class="d-flex justify-content-between mb-2">
                            <span>Subtotal:</span>
                            <span>$@Model.Cart.Subtotal.ToString("0.00")</span>
                        </div>
                        <div class="d-flex justify-content-between mb-2">
                            <span>Shipping:</span>
                            <span>$@Model.Cart.ShippingFee.ToString("0.00")</span>
                        </div>
                        <div class="d-flex justify-content-between fw-bold fs-5">
                            <span>Total:</span>
                            <span>$@Model.Cart.Total.ToString("0.00")</span>
                        </div>
                    </div>

                    <div class="mt-3">
                        <a href="/Cart" class="btn btn-outline-secondary w-100">
                            <i class="fas fa-arrow-left me-2"></i> Back to Cart
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        function confirmPayment() {
            // 1. تأكيد تأشيرة الـ Checkbox
            if (!document.getElementById('confirmOrder').checked) {
                alert('❌ Please confirm your order details before payment.');
                return false;
            }

            // 2. التأكد من إدخال العنوان
            var address = document.querySelector('textarea[name="ShippingAddress"]').value;
            if (!address.trim()) {
                alert('❌ Please enter your shipping address.');
                return false;
            }

            // 3. التأكد من اختيار طريقة الدفع
            var paymentMethod = document.querySelector('select[name="PaymentMethod"]').value;
            if (!paymentMethod) {
                alert('❌ Please select a payment method.');
                return false;
            }

            // 4. تأكيد نهائي مع المبلغ
            var total = '@Model.Cart.Total.ToString("0.00")';
            return confirm(`Are you sure you want to complete this purchase for $${total}?\n\nOrder Details:\n- Items: @Model.Cart.ItemCount\n- Shipping: $@Model.Cart.ShippingFee.ToString("0.00")\n- Total: $${total}`);
        }

        // لمنع إرسال الفورم بالخطأ بالـ Enter
        document.getElementById('checkoutForm').addEventListener('keypress', function(e) {
            if (e.key === 'Enter') {
                e.preventDefault();
            }
        });
    </script>
}