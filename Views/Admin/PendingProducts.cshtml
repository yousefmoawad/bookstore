@model List<BookStore.Models.Entities.Product>
@{
    ViewData["Title"] = "Pending Products";
}

<div class="container-fluid py-4">
    <h1 class="mb-4">Pending Products Approval</h1>

    @if (Model != null && Model.Any())
    {
        <div class="card">
            <div class="card-body">
                <div class="table-responsive">
                    <table class="table table-hover">
                        <thead>
                            <tr>
                                <th>ID</th>
                                <th>Title</th>
                                <th>Author</th>
                                <th>Price</th>
                                <th>Added Date</th>
                                <th>Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var product in Model)
                            {
                                <tr>
                                    <td>@product.Id</td>
                                    <td>@product.Title</td>
                                    <td>@product.Author</td>
                                    <td>$@product.Price.ToString("0.00")</td>
                                    <td>@product.CreatedAt.ToString("dd/MM/yyyy")</td>
                                    <td>
                                        <form asp-action="ApproveProduct" method="post">
                                            <input type="hidden" name="id" value="@product.Id" />
                                            <button type="submit" class="btn btn-success btn-sm">
                                                <i class="fas fa-check"></i> Approve
                                            </button>
                                        </form>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    }
    else
    {
        <div class="alert alert-info">
            No pending products for approval.
        </div>
    }

    <a asp-action="Dashboard" class="btn btn-secondary mt-3">
        <i class="fas fa-arrow-left"></i> Back to Dashboard
    </a>
</div>