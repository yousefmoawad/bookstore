@model IEnumerable<BookStore.Models.Entities.Product>
@using Microsoft.AspNetCore.Identity
@{
    ViewData["Title"] = "Manage Products";

    // استخدم IdentityUser مباشرة (بدون مشاكل)
    var isSuperAdmin = User.IsInRole("SuperAdmin");
    var isAdmin = User.IsInRole("Admin");
}

<div class="container py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2>Manage Products</h2>

        @if (isAdmin || isSuperAdmin)
        {
            <a asp-action="AddProduct" class="btn btn-primary">
                <i class="fas fa-plus me-2"></i>Add New Product
            </a>
        }
    </div>

    <!-- رسائل التنبيه -->
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show">
            @TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show">
            @TempData["ErrorMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <!-- جدول المنتجات -->
    <div class="card shadow">
        <div class="card-body">
            @if (!Model.Any())
            {
                <div class="text-center py-5">
                    <i class="fas fa-box-open fa-3x text-muted mb-3"></i>
                    <h4>No products found</h4>
                </div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-hover">
                        <thead class="table-light">
                            <tr>
                                <th>ID</th>
                                <th>Title</th>
                                <th>Author</th>
                                <th>Price</th>
                                <th>Stock</th>
                                <th>Status</th>
                                <th>Date</th>
                                <th>Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var product in Model)
                            {
                                <tr>
                                    <td>@product.Id</td>
                                    <td>
                                        <strong>@product.Title</strong>
                                        @if (!string.IsNullOrEmpty(product.Description))
                                        {
                                            <small class="d-block text-muted">@(product.Description.Length > 50 ? product.Description.Substring(0, 50) + "..." : product.Description)</small>
                                        }
                                    </td>
                                    <td>@product.Author</td>
                                    <td><span class="fw-bold">$@product.Price.ToString("0.00")</span></td>
                                    <td>
                                        @if (product.StockQuantity <= 0)
                                        {
                                            <span class="badge bg-danger">Out of Stock</span>
                                        }
                                        else if (product.StockQuantity < 10)
                                        {
                                            <span class="badge bg-warning">Low: @product.StockQuantity</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-success">@product.StockQuantity</span>
                                        }
                                    </td>
                                    <td>
                                        @if (product.Status == "Active")
                                        {
                                            <span class="badge bg-success">
                                                <i class="fas fa-check me-1"></i>Approved
                                            </span>
                                        }
                                        else if (product.Status == "Rejected")
                                        {
                                            <span class="badge bg-danger">
                                                <i class="fas fa-times me-1"></i>Rejected
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-warning">
                                                <i class="fas fa-clock me-1"></i>Pending
                                            </span>
                                        }
                                    </td>
                                    <td>@product.CreatedAt.ToString("dd/MM/yyyy")</td>
                                    <td>
                                        <div class="btn-group" role="group">
                                            <!-- زر المشاهدة -->
                                            <a href="/Shop/Details/@product.Id"
                                               class="btn btn-sm btn-outline-info"
                                               title="View">
                                                <i class="fas fa-eye"></i>
                                            </a>

                                            <!-- SuperAdmin فقط: أزرار الموافقة والرفض -->
                                            @if (isSuperAdmin && product.Status == "Pending")
                                            {
                                                <form method="post"
                                                      asp-action="ApproveProduct"
                                                      class="d-inline"
                                                      onsubmit="return confirm('Approve this product?')">
                                                    @Html.AntiForgeryToken()
                                                    <input type="hidden" name="id" value="@product.Id" />
                                                    <button type="submit"
                                                            class="btn btn-sm btn-success"
                                                            title="Approve">
                                                        <i class="fas fa-check"></i>
                                                    </button>
                                                </form>

                                                <form method="post"
                                                      asp-action="RejectProduct"
                                                      class="d-inline"
                                                      onsubmit="return confirm('Reject this product?')">
                                                    @Html.AntiForgeryToken()
                                                    <input type="hidden" name="id" value="@product.Id" />
                                                    <button type="submit"
                                                            class="btn btn-sm btn-danger"
                                                            title="Reject">
                                                        <i class="fas fa-times"></i>
                                                    </button>
                                                </form>
                                            }

                                            <!-- التعديل والحذف للمنتجات النشطة -->
                                            @if ((isSuperAdmin || (isAdmin && product.Status == "Active")) && product.Status != "Rejected")
                                            {
                                                <a asp-action="EditProduct"
                                                   asp-route-id="@product.Id"
                                                   class="btn btn-sm btn-outline-warning"
                                                   title="Edit">
                                                    <i class="fas fa-edit"></i>
                                                </a>

                                                <form method="post"
                                                      asp-action="DeleteProduct"
                                                      class="d-inline"
                                                      onsubmit="return confirm('Delete this product?')">
                                                    @Html.AntiForgeryToken()
                                                    <input type="hidden" name="id" value="@product.Id" />
                                                    <button type="submit"
                                                            class="btn btn-sm btn-outline-danger"
                                                            title="Delete">
                                                        <i class="fas fa-trash"></i>
                                                    </button>
                                                </form>
                                            }
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>
</div>