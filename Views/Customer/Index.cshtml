@{
    ViewData["Title"] = "My Account";
}

<div class="container py-5">
    <h1 class="display-4 fw-bold mb-4">My Account</h1>

    <div class="row">
        <!-- Sidebar -->
        <div class="col-md-3 mb-4">
            <div class="card shadow-sm">
                <div class="card-body">
                    <div class="text-center mb-4">
                        <div style="font-size: 4rem; color: #667eea;">👤</div>
                        <h5 class="mt-2">@User.Identity?.Name</h5>
                        <small class="text-muted">Customer</small>
                    </div>

                    <div class="list-group">
                        <a href="/Customer" class="list-group-item list-group-item-action active">
                            Dashboard
                        </a>
                        <a href="/Order/MyOrders" class="list-group-item list-group-item-action">
                            My Orders
                        </a>
                        <a href="/Customer/AddProduct" class="list-group-item list-group-item-action">
                            Add Product
                        </a>
                        <a href="/Identity/Account/Manage" class="list-group-item list-group-item-action">
                            Profile Settings
                        </a>
                    </div>
                </div>
            </div>
        </div>

        <!-- Main Content -->
        <div class="col-md-9">
            <!-- Welcome Card -->
            <div class="card shadow-sm mb-4">
                <div class="card-body">
                    <h5 class="card-title fw-bold">Welcome back!</h5>
                    <p class="card-text">
                        Manage your account, view your orders, and add new products for approval.
                    </p>
                </div>
            </div>

            <!-- Quick Stats -->
            <div class="row mb-4">
                <div class="col-md-4 mb-3">
                    <div class="card bg-light shadow-sm">
                        <div class="card-body text-center">
                            <div style="font-size: 2rem; color: #667eea;">📦</div>
                            <h3 class="mt-2">0</h3>
                            <p class="text-muted mb-0">Total Orders</p>
                        </div>
                    </div>
                </div>

                <div class="col-md-4 mb-3">
                    <div class="card bg-light shadow-sm">
                        <div class="card-body text-center">
                            <div style="font-size: 2rem; color: #667eea;">📚</div>
                            <h3 class="mt-2">0</h3>
                            <p class="text-muted mb-0">My Products</p>
                        </div>
                    </div>
                </div>

                <div class="col-md-4 mb-3">
                    <div class="card bg-light shadow-sm">
                        <div class="card-body text-center">
                            <div style="font-size: 2rem; color: #667eea;">✅</div>
                            <h3 class="mt-2">0</h3>
                            <p class="text-muted mb-0">Approved Products</p>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Recent Activity -->
            <div class="card shadow-sm">
                <div class="card-body">
                    <h5 class="card-title fw-bold mb-3">Recent Activity</h5>
                    <div class="alert alert-info">
                        <div class="d-flex">
                            <div style="font-size: 1.5rem; margin-right: 10px;">📋</div>
                            <div>
                                <h6 class="alert-heading">Welcome to Book Store!</h6>
                                <p class="mb-0">Start by browsing books or adding your own products.</p>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>